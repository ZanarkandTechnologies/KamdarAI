{
  "artifact_type": "kamdar-project-diff-plan",
  "artifact_version": "0.1.0",
  "context": {
    "context_diff_id": "{{CONTEXT_DIFF_ID}}",
    "context_diff_path": "{{CONTEXT_DIFF_PATH}}",
    "local_day": "{{LOCAL_DAY}}",
    "evidence_window": "{{EVIDENCE_WINDOW}}"
  },
  "state": "{{proposed | no_finding | blocked}}",
  "patches": [
    {
      "patch_id": "{{PATCH_ID}}",
      "project": {
        "project_id": "{{PROJECT_ID}}",
        "project_source_id": "{{PROJECT_SOURCE_ID}}",
        "project_url": "{{PROJECT_URL}}"
      },
      "target_section": "{{project_knowledge | this_weeks_attention}}",
      "operation": "{{append | replace}}",
      "before_excerpt": "{{CURRENT_RELEVANT_SECTION_EXCERPT}}",
      "proposed_markdown": "{{MARKDOWN_TO_APPEND_OR_REPLACE}}",
      "source_ids": ["{{SOURCE_ID}}"],
      "attention_reset": {
        "requested": "{{true | false}}",
        "week": "{{RESET_WEEK_OR_NULL}}",
        "reason": "{{EXACT_RESET_REASON_OR_NULL}}",
        "source_id": "{{RESET_SOURCE_ID_OR_NULL}}"
      },
      "gaps": ["{{UNVERIFIED_FACT_OR_EMPTY}}"],
      "idempotency_key": "project-memory:{{LOCAL_DAY}}:{{PROJECT_ID}}:{{TARGET_SECTION}}:{{SOURCE_FINGERPRINT}}"
    }
  ],
  "no_change_project_ids": ["{{PROJECT_ID_WITH_NO_MATERIAL_CHANGE}}"],
  "source_gaps": ["{{CONTEXT_LEVEL_GAP_OR_EMPTY}}"],
  "integration_handoff": {
    "owner": "apply-project-diffs",
    "application_state": "proposal-only",
    "receipt_required_before_applied_claim": true
  }
}
