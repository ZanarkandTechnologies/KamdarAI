{
  "schema_version": 2,
  "id": "kamdar-daily-company-showcase",
  "title": "Daily company manager showcase",
  "operator_request": "Run today's company operating update. Show me what changed this week, what needs attention, who needs a follow-up, and the summary I should receive.",
  "frozen_clock": "2026-08-21T09:00:00+08:00",
  "fixture_root": "../fixtures/daily-company-showcase",
  "reference_points": [
    {
      "id": "source-selection",
      "text": "Select the latest area reports, tasks changed this week, linked projects and owners, directory contacts, and current Drive resources; exclude older work.",
      "assertion_ids": ["selection:included:TASK-101", "selection:included:TASK-102", "selection:included:TASK-103", "selection:excluded:TASK-104", "selection:latest:Retail Operations:REPORT-RETAIL-W34", "selection:person:PERSON-AISHA", "selection:person:PERSON-DARREN", "selection:resource:DRIVE-RESOURCE-1", "selection:resource:DRIVE-RESOURCE-2", "selection:resource:DRIVE-RESOURCE-3"]
    },
    {
      "id": "area-reporting",
      "text": "Update one weekly report per area, keep project subsections, and preserve exact task progress, blockers, documentation quality, next actions, and source links.",
      "assertion_ids": ["file:retail-report", "file:digital-report", "content:retail-report", "content:digital-report"]
    },
    {
      "id": "company-rollup",
      "text": "Aggregate the two area reports into one company rollup without replacing canonical project or task detail.",
      "assertion_ids": ["file:company-rollup", "content:company-rollup"]
    },
    {
      "id": "targeted-chases",
      "text": "Request progress only for stale blocked work and request documentation improvements only for missing template fields.",
      "assertion_ids": ["tool:notion-progress-comment", "tool:notion-quality-comment"]
    },
    {
      "id": "directory-email-routing",
      "text": "Resolve each project owner through the company directory, group work items per employee, archive the exact messages, and record the email sends.",
      "assertion_ids": ["tool:directory-before-email", "tool:email-aisha", "tool:email-darren", "file:email-archive", "content:email-archive"]
    },
    {
      "id": "owner-delivery",
      "text": "Record one Telegram delivery containing the overall company result and owner-attention count.",
      "assertion_ids": ["tool:telegram-summary", "file:telegram-archive", "content:telegram-archive"]
    },
    {
      "id": "safe-repeatability",
      "text": "Label every connector action as recorded or mocked and make a second run update managed reports without duplicating files, comments, emails, or Telegram messages.",
      "assertion_ids": ["idempotency:all", "content:showcase-safety"]
    }
  ],
  "expected_selection": {
    "included_task_ids": ["TASK-101", "TASK-102", "TASK-103"],
    "excluded_task_ids": ["TASK-104"],
    "project_ids": ["PROJ-MERCH", "PROJ-REPLENISH", "PROJ-SUPPLIER"],
    "people_ids": ["PERSON-AISHA", "PERSON-DARREN"],
    "resource_ids": ["DRIVE-RESOURCE-1", "DRIVE-RESOURCE-2", "DRIVE-RESOURCE-3"],
    "latest_reports": {
      "Retail Operations": "REPORT-RETAIL-W34",
      "Digital Commerce": "REPORT-DIGITAL-W33"
    }
  },
  "expected_tool_calls": [
    {"id": "query-week-tasks", "adapter": "notion", "operation": "query_tasks_modified", "phase": "run-1", "times": 1, "args_contain": ["2026-08-17", "2026-08-24"]},
    {"id": "fetch-projects", "adapter": "notion", "operation": "fetch_projects", "phase": "run-1", "times": 1, "args_contain": ["PROJ-REPLENISH", "PROJ-MERCH"]},
    {"id": "fetch-directory", "adapter": "notion", "operation": "fetch_people_directory", "phase": "run-1", "times": 1, "args_contain": ["PERSON-AISHA", "PERSON-DARREN"]},
    {"id": "list-resources", "adapter": "drive", "operation": "list_project_resources", "phase": "run-1", "times": 1, "args_contain": ["PROJ-SUPPLIER"]},
    {"id": "upsert-area-and-company-reports", "adapter": "drive", "operation": "upsert_markdown", "phase": "run-1", "times": 3, "args_contain": ["2026-W34"]},
    {"id": "notion-progress-comment", "adapter": "notion", "operation": "create_task_comment", "phase": "run-1", "times": 1, "args_contain": ["TASK-101", "Expected resolution date"]},
    {"id": "notion-quality-comment", "adapter": "notion", "operation": "create_task_comment", "phase": "run-1", "times": 1, "args_contain": ["TASK-102", "Acceptance evidence", "Rollout owner"]},
    {"id": "email-aisha", "adapter": "email", "operation": "send_message", "phase": "run-1", "times": 1, "args_contain": ["PERSON-AISHA", "TASK-101"]},
    {"id": "email-darren", "adapter": "email", "operation": "send_message", "phase": "run-1", "times": 1, "args_contain": ["PERSON-DARREN", "TASK-102"]},
    {"id": "telegram-summary", "adapter": "telegram", "operation": "send_message", "phase": "run-1", "times": 1, "args_contain": ["telegram:2026-08-21:owner-summary", "2 follow-ups"]}
  ],
  "expected_file_events": [
    {"id": "retail-report", "path": "reports/areas/retail-operations/weekly-report-2026-W34.md", "event": "modified"},
    {"id": "digital-report", "path": "reports/areas/digital-commerce/weekly-report-2026-W34.md", "event": "created"},
    {"id": "company-rollup", "path": "reports/company/weekly-report-2026-W34.md", "event": "created"},
    {"id": "email-archive", "path": "outreach/email-followups-2026-08-21.md", "event": "created"},
    {"id": "telegram-archive", "path": "outreach/telegram-summary-2026-08-21.md", "event": "created"}
  ],
  "content_assertions": [
    {"id": "retail-report", "path": "reports/areas/retail-operations/weekly-report-2026-W34.md", "present": ["## Store Replenishment", "TASK-101", "412-unit variance", "Warehouse reconciliation owner", "## Supplier Onboarding", "TASK-103", "approved version 3", "https://drive.example.test/resources/replenishment-sop"], "absent": ["TASK-104", "{{"]},
    {"id": "digital-report", "path": "reports/areas/digital-commerce/weekly-report-2026-W34.md", "present": ["## Online Merchandising", "TASK-102", "mobile evidence is not attached", "Acceptance evidence", "Rollout owner", "https://drive.example.test/resources/festive-qa-checklist"], "absent": ["TASK-104", "July photography", "{{"]},
    {"id": "company-rollup", "path": "reports/company/weekly-report-2026-W34.md", "present": ["Retail Operations", "Digital Commerce", "TASK-101", "TASK-102", "TASK-103", "2 follow-ups"], "absent": ["TASK-104", "{{"]},
    {"id": "email-archive", "path": "outreach/email-followups-2026-08-21.md", "present": ["aisha.operations@example.test", "darren.commerce@example.test", "TASK-101", "TASK-102", "MOCK DELIVERY ARCHIVE"], "absent": ["TASK-104", "REAL RECIPIENT"]},
    {"id": "telegram-archive", "path": "outreach/telegram-summary-2026-08-21.md", "present": ["MOCK TELEGRAM DELIVERY", "3 tasks", "2 areas", "2 follow-ups"], "absent": ["TASK-104"]},
    {"id": "showcase-safety", "path": "showcase/index.md", "present": ["Mocked connector proof", "No network calls were made", "Recorded tool activity"], "absent": ["REAL RECIPIENT"]}
  ],
  "expected_idempotency": {
    "duplicate_files": 0,
    "duplicate_actions": 0,
    "second_run_new_external_actions": 0
  }
}
